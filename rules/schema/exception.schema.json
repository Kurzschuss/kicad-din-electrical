{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kurzschuss/kicad-din-electrical/rules/schema/exception.schema.json",
  "title": "Dokumentierte Qualitätsausnahme",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rule_id", "element", "status", "reason", "references"],
  "properties": {
    "id": {"type": "string", "pattern": "^EX-[0-9]{4}$"},
    "rule_id": {"type": "string", "minLength": 1},
    "element": {"type": "string", "minLength": 1},
    "status": {"enum": ["z_conform", "temporarily_accepted"]},
    "reason": {"type": "string", "minLength": 1},
    "expires": {"type": "string", "format": "date"},
    "review_on": {"type": "string", "format": "date"},
    "references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "anyOf": [
    {"required": ["expires"]},
    {"required": ["review_on"]}
  ]
}
