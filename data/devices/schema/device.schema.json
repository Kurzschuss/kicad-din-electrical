{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KiCad DIN Electrical Device",
  "type": "object",
  "required": [
    "id",
    "manufacturer",
    "series",
    "part_number",
    "device_type",
    "function_group",
    "symbol",
    "footprint_policy"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "manufacturer": {"type": "string", "minLength": 1},
    "series": {"type": "string", "minLength": 1},
    "part_number": {"type": "string", "minLength": 1},
    "device_type": {"type": "string", "minLength": 1},
    "function_group": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "poles": {"type": "integer", "minimum": 1},
    "rated_current_a": {"type": "number", "exclusiveMinimum": 0},
    "trip_curve": {"type": "string"},
    "breaking_capacity_ka": {"type": "number", "exclusiveMinimum": 0},
    "modules": {"type": "number", "exclusiveMinimum": 0},
    "symbol": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$"},
    "footprint_policy": {"enum": ["required", "optional", "none"]},
    "footprint": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$"},
    "datasheet": {"type": "string"},
    "source_status": {"enum": ["template", "verified", "unverified"]}
  },
  "additionalProperties": false
}
